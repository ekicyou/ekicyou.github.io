---
import '../styles/prose.css';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import type { PageMeta } from '../components/HeadMeta.astro';
import Toc, { tocItems } from '../components/Toc.astro';
import TagList from '../components/TagList.astro';
import PostNav, { type NavLink } from '../components/PostNav.astro';
import Comments from '../components/Comments.astro';
import CodeCopy from '../components/CodeCopy.astro';

interface Props extends PageMeta {
  title: string;
  dateText?: string | undefined;
  tags?: readonly string[] | undefined;
  headings?: readonly MarkdownHeading[] | undefined;
  comments: boolean;
  older?: NavLink | undefined;
  newer?: NavLink | undefined;
}
const { dateText, tags, headings, comments, older, newer, ...meta } = Astro.props;
const items = headings ? tocItems(headings) : [];
const hasToc = items.length >= 2;
---
<BaseLayout {...meta}>
  <article class:list={['article', { 'has-toc': hasToc }]}>
    <header class="article-header">
      <h1 class="article-title">{meta.title}</h1>
      {(dateText || (tags && tags.length > 0)) && (
        <p class="article-meta">
          {dateText && <time datetime={dateText}>{dateText}</time>}
          {tags && tags.length > 0 && <TagList tags={tags} />}
        </p>
      )}
    </header>
    {hasToc && <Toc items={items} />}
    <div class="article-body">
      <div class="prose"><slot /></div>
      {(older || newer) && <PostNav older={older} newer={newer} />}
      {comments && <Comments />}
    </div>
  </article>
  <CodeCopy />
</BaseLayout>
